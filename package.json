{
  "name": "webtrix-node-setup",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#config/*": "./src/config/*",
    "#middlewares/*": "./src/middlewares/*",
    "#modules/*": "./src/modules/*",
    "#routes/*": "./src/routes/*",
    "#shared/*": "./src/shared/*",
    "#socket/*": "./src/socket/*",
    "#templates/*": "./src/templates/*"
  },
  "description": "Express migration scaffold for the legacy CodeIgniter API",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "routes": "node src/scripts/printRoutes.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "handlebars": "^4.7.9",
    "joi": "^18.1.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.3",
    "nodemailer": "^8.0.6",
    "socket.io": "^4.8.3",
    "xlsx": "^0.18.5"
  }
}
